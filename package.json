{
  "name": "kepych-eco-zrub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPA-платформа дерев'яного будівництва KEPYCH ECO ZRUB на базі React 18, Vite, ESLint, Prettier, Husky та Cypress",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:component": "cypress run --component",
    "test:e2e": "cypress run --e2e",
    "cypress:open": "cypress open"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "cypress": "^13.15.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.4.35",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0"
  }
}
